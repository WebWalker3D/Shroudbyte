<?xml version="1.0" encoding="utf-8"?>
<!--
    Privacy posture: explicitly opt out of cloud + device-transfer
    backups. Shroudbyte data (history, bookmarks, encrypted addresses)
    should not leak to a Google account.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
